      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst DEFAULT_OFFSET = '+08:00'; // Manila\n\nfunction validateAndFormat(rawDate) {\n  if (typeof rawDate !== 'string' || !rawDate.trim()) return null;\n\n  let cleanedDate = rawDate.trim();\n\n  // A timezone-aware ISO date is required or defaults to Manila time.\n  if (!cleanedDate.endsWith('Z') && !/[+-]\\d{2}:?\\d{2}$/.test(cleanedDate)) {\n    cleanedDate += DEFAULT_OFFSET;\n  }\n\n  const parsed = new Date(cleanedDate);\n  if (Number.isNaN(parsed.getTime())) return null;\n\n  return parsed.toISOString();\n}\n\nconst startTime = validateAndFormat(inputData.startTime);\nconst endTime = validateAndFormat(inputData.endTime);\nconst summary = inputData.summary || inputData.Summary || inputData.title || 'New Event';\n\nif (!startTime || !endTime) {\n  return {\n    json: {\n      success: false,\n      error: 'Provide valid ISO dates, e.g. 2026-09-23T09:00:00+08:00.',\n    },\n  };\n}\n\nif (new Date(startTime) >= new Date(endTime)) {\n  return {\n    json: {\n      success: false,\n      error: 'endTime must be after startTime.',\n    },\n  };\n}\n\nreturn {\n  json: {\n    ...inputData,\n    success: true,\n    Summary: summary,\n    startTime,\n    endTime,\n  },\n};"
      },
