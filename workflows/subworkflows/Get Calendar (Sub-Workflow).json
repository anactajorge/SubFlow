      "parameters": {
        "jsCode": "const inputData = $input.first().json;\n\nfunction validateAndFormat(rawDate) {\n  if (!rawDate || typeof rawDate !== 'string') return null;\n\n  // If the model didn't include a timezone offset (Z or +XX:XX), default to +08:00 (Manila)\n  let cleanedDate = rawDate.trim();\n  if (!cleanedDate.endsWith('Z') && !/[+-]\\d{2}:?\\d{2}$/.test(cleanedDate)) {\n    cleanedDate += '+08:00';\n  }\n\n  const parsed = new Date(cleanedDate);\n  if (isNaN(parsed.getTime())) return null;\n\n  return parsed.toISOString();\n}\n\nconst startISO = validateAndFormat(inputData.startTime);\nconst endISO = validateAndFormat(inputData.endTime);\n\nif (!startISO || !endISO) {\n  return {\n    json: {\n      success: false,\n      error: `Invalid date format received. Received startTime: \"${inputData.startTime}\", endTime: \"${inputData.endTime}\".`\n    }\n  };\n}\n\nif (new Date(startISO) >= new Date(endISO)) {\n  return {\n    json: {\n      success: false,\n      error: \"Logical error: endTime must be after startTime.\"\n    }\n  };\n}\n\nreturn {\n  json: {\n    success: true,\n    startTime: startISO,\n    endTime: endISO\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
