    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Check if the output was empty (handled by Always Output Data)\nconst hasEvents = items.length > 0 && items[0].json.id !== undefined;\n\nif (!hasEvents) {\n  return {\n    json: {\n      isAvailable: true,\n      message: \"The time slot is free. No conflicting events found.\",\n      events: []\n    }\n  };\n}\n\nconst events = items.map(item => ({\n  summary: item.json.summary || \"Busy (No title)\",\n  description: item.json.description || \"No description provided\",\n  start: item.json.start?.dateTime || item.json.start?.date,\n  end: item.json.end?.dateTime || item.json.end?.date\n}));\n\nreturn {\n  json: {\n    isAvailable: false,\n    message: `Busy. Found ${events.length} conflicting event(s).`,\n    events: events\n  }\n};"
      },
